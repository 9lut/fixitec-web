---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ContactForm from '../components/ContactForm.astro';
import MapEmbed from '../components/MapEmbed.astro';
import TapeBand from '../components/TapeBand.astro';
import { pageSeo } from '../config/seo';
import { contact, location } from '../config/site';

const seo = pageSeo.contact;
const crumbs = [{ name: 'ติดต่อ', href: '/contact/' }];

const channels = [
  { icon: 'mdi:phone', label: 'โทร', value: contact.phone.display, href: contact.phone.href, external: false },
  { icon: 'simple-icons:line', label: 'LINE', value: contact.line.id, href: contact.line.href, external: true },
  { icon: 'mdi:email-outline', label: 'อีเมล', value: contact.email.display, href: contact.email.href, external: false },
];
---

<Layout title={seo.title} description={seo.description} crumbs={crumbs} pageType="ContactPage">
  <PageHero crumbs={crumbs} kicker="ติดต่อ" title="ปรึกษาฟรี ไม่มีข้อผูกมัด" lead="กรอกข้อมูลเบื้องต้น ทีมจะติดต่อกลับเพื่อนัดสำรวจระบบและเสนอราคา หรือโทร / LINE หาเราได้ทันที" />

  <TapeBand />

  <section class="bg-white pt-20 pb-14 lg:pt-28 lg:pb-20">
    <div class="wrap grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-12">
      <div class="min-w-0">
        <h2 class="h-section mb-6">ขอใบเสนอราคา</h2>
        <ContactForm />
      </div>

      <aside class="min-w-0 space-y-6">
        <div>
          <h2 class="font-display text-xl font-semibold">ติดต่อโดยตรง</h2>
          <ul class="mt-4 space-y-3">
            {
              channels.map((c) => (
                <li>
                  <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})} class="card group flex items-center gap-4 p-4">
                    <span class="grid size-11 shrink-0 place-items-center bg-brand">
                      <Icon name={c.icon} class="size-5" />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-[13px] text-muted">{c.label}</span>
                      <span class="block truncate font-display text-lg font-medium">{c.value}</span>
                    </span>
                    <Icon name="mdi:arrow-right" class="arrow ml-auto size-5 shrink-0 text-ink/40" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-paper p-5">
          <h2 class="flex items-center gap-2 font-display text-lg font-semibold"><Icon name="mdi:clock-outline" class="size-5" />เวลาทำการ</h2>
          <dl class="mt-3 space-y-1.5 text-[15px]">
            {
              contact.hours.map((h) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">{h.days}</dt>
                  <dd class="text-right">{h.time}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-3 border-t border-line pt-3 text-[13px] text-muted">แจ้งปัญหาผ่าน LINE ได้ตลอด ทีมรับเรื่องในเวลาทำการถัดไป</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-line bg-paper py-14 lg:py-20">
    <div class="wrap grid grid-cols-1 gap-10 xl:grid-cols-[1fr_1.6fr] xl:items-start xl:gap-14 [&>*]:min-w-0">
      <div>
        <SectionHead kicker="แผนที่" title="ที่ตั้งและพื้นที่บริการ" />
        <dl class="mt-8 space-y-5 text-[15px]">
          <div>
            <dt class="font-display font-semibold">ที่ตั้ง</dt>
            <dd class="mt-1 text-muted">{location.address}</dd>
          </div>
          <div>
            <dt class="font-display font-semibold">On-site ถึงหน้างาน</dt>
            <dd class="mt-1 text-muted">{location.onsiteArea.join(' · ')}</dd>
          </div>
          <div>
            <dt class="font-display font-semibold">Remote Support</dt>
            <dd class="mt-1 text-muted">ให้บริการ{location.remoteArea}</dd>
          </div>
        </dl>
      </div>
      <MapEmbed class="aspect-square sm:aspect-[16/10]" />
    </div>
  </section>
</Layout>
