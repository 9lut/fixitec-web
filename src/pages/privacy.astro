---
import LegalPage from '../components/LegalPage.astro';
import { pageSeo } from '../config/seo';
import { company, contact } from '../config/site';

const seo = pageSeo.privacy;
// TODO: ให้ฝ่ายกฎหมายตรวจทานก่อนใช้งานจริง
---

<LegalPage title="นโยบายความเป็นส่วนตัว" seoTitle={seo.title} description={seo.description} href="/privacy/" updated="23 ตุลาคม 2569">
  <p>
    {company.th} (“บริษัท”) ผู้ให้บริการ FIXITEC ให้ความสำคัญกับการคุ้มครองข้อมูลส่วนบุคคลของคุณตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 (PDPA)
    นโยบายนี้อธิบายว่าเราเก็บ ใช้ และดูแลข้อมูลของคุณอย่างไรเมื่อใช้งานเว็บไซต์และติดต่อเรา
  </p>

  <h2>ข้อมูลที่เราเก็บ</h2>
  <ul>
    <li>ข้อมูลที่คุณกรอกในแบบฟอร์ม เช่น ชื่อ บริษัท เบอร์โทร อีเมล และรายละเอียดความต้องการ</li>
    <li>ข้อมูลที่ได้จากการติดต่อผ่านโทรศัพท์ LINE หรืออีเมล</li>
    <li>ข้อมูลทางเทคนิคพื้นฐานจากการเข้าชมเว็บไซต์ เช่น ประเภทอุปกรณ์และเบราว์เซอร์</li>
  </ul>

  <h2>วัตถุประสงค์การใช้ข้อมูล</h2>
  <ul>
    <li>ติดต่อกลับ นัดสำรวจระบบ และจัดทำใบเสนอราคา</li>
    <li>ให้บริการตามสัญญาและติดตามงาน</li>
    <li>ปรับปรุงเว็บไซต์และบริการ</li>
  </ul>

  <h2>การเปิดเผยข้อมูล</h2>
  <p>เราไม่ขายหรือให้เช่าข้อมูลส่วนบุคคลของคุณ และจะเปิดเผยเฉพาะเท่าที่จำเป็นต่อการให้บริการ หรือเมื่อกฎหมายกำหนด</p>

  <h2>ระยะเวลาการเก็บรักษา</h2>
  <p>เราเก็บข้อมูลเท่าที่จำเป็นตามวัตถุประสงค์ข้างต้น หรือตามระยะเวลาที่กฎหมายกำหนด จากนั้นจะลบหรือทำให้ไม่สามารถระบุตัวตนได้</p>

  <h2>สิทธิของเจ้าของข้อมูล</h2>
  <p>คุณมีสิทธิขอเข้าถึง แก้ไข ลบ ระงับการใช้ หรือคัดค้านการประมวลผลข้อมูลของคุณ รวมถึงถอนความยินยอมได้ตลอดเวลา</p>

  <h2>ติดต่อเรา</h2>
  <p>หากมีคำถามเกี่ยวกับนโยบายนี้ ติดต่อ {company.th} ทางอีเมล {contact.email.display} หรือโทร {contact.phone.display}</p>
</LegalPage>
