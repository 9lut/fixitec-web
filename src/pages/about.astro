---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import TapeBand from '../components/TapeBand.astro';
import BrandVisual from '../components/BrandVisual.astro';
import Clients from '../components/Clients.astro';
import { pageSeo } from '../config/seo';
import { company } from '../config/site';
import { about } from '../data/home';

const seo = pageSeo.about;
const crumbs = [{ name: 'เกี่ยวกับเรา', href: '/about/' }];
---

<Layout title={seo.title} description={seo.description} crumbs={crumbs} pageType="AboutPage">
  <PageHero crumbs={crumbs} kicker="เกี่ยวกับเรา" title={about.title} lead={about.lead} />

  <TapeBand />

  <section class="bg-white pt-20 pb-20 lg:pt-28 lg:pb-32">
    <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-center lg:gap-16 [&>*]:min-w-0">
      <BrandVisual />
      <div>
        <SectionHead kicker="เรื่องราวของเรา" title="ทำไมต้องมี FIXITEC" />
        {about.story.map((p) => <p class="mt-5 text-[17px] leading-relaxed text-ink/80">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="slant bg-dots-dark bg-ink">
    <div class="wrap">
      <SectionHead kicker="We Care Beyond Tech" title="สิ่งที่เรายึดถือ" dark />
      <ul class="swipe-row mt-8 sm:grid-cols-2 lg:mt-10 lg:grid-cols-4">
        {
          about.values.map((v, i) => (
            <li class="card p-6">
              <span class="font-display text-sm text-ink/35">0{i + 1}</span>
              <h3 class="mt-3 font-display text-xl font-semibold">{v.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{v.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white pt-20 pb-14 lg:pt-32 lg:pb-20">
    <div class="wrap">
      <div class="cut-corner grid gap-8 bg-fix-50 p-6 sm:p-10 lg:grid-cols-[auto_1fr_auto] lg:items-center">
        <span class="grid size-16 place-items-center bg-ink text-brand">
          <Icon name="mdi:domain" class="size-8" />
        </span>
        <div>
          <h2 class="h-section">{about.parent.title}</h2>
          <p class="mt-3 max-w-2xl text-[17px] leading-relaxed text-ink/80">{about.parent.desc}</p>
          <p class="mt-3 text-[15px] text-muted">{company.th} · {company.en} · เลขทะเบียน {company.registration}</p>
        </div>
        <a href={company.url} target="_blank" rel="noopener" class="btn btn-outline">เว็บไซต์ SUCASOFT <Icon name="mdi:open-in-new" class="size-4" /></a>
      </div>
    </div>
  </section>

  <Clients />

  <CtaBand />
</Layout>
