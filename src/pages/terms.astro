---
import LegalPage from '../components/LegalPage.astro';
import { pageSeo } from '../config/seo';
import { company, contact } from '../config/site';

const seo = pageSeo.terms;
// TODO: ให้ฝ่ายกฎหมายตรวจทานก่อนใช้งานจริง
---

<LegalPage title="ข้อตกลงการใช้งาน" seoTitle={seo.title} description={seo.description} href="/terms/" updated="23 ตุลาคม 2569">
  <p>การเข้าใช้งานเว็บไซต์ FIXITEC ซึ่งดำเนินการโดย {company.th} ถือว่าคุณยอมรับข้อตกลงต่อไปนี้</p>

  <h2>การใช้งานเว็บไซต์</h2>
  <p>เนื้อหาบนเว็บไซต์นี้จัดทำเพื่อให้ข้อมูลเกี่ยวกับบริการเท่านั้น ห้ามนำไปใช้ในทางที่ผิดกฎหมายหรือก่อให้เกิดความเสียหายต่อผู้อื่น</p>

  <h2>ข้อมูลบริการและราคา</h2>
  <p>รายละเอียดบริการ แพ็กเกจ และระดับการตอบสนองบนเว็บไซต์เป็นข้อมูลเบื้องต้น เงื่อนไขที่มีผลผูกพันเป็นไปตามใบเสนอราคาและสัญญาที่ลงนามร่วมกัน</p>

  <h2>ทรัพย์สินทางปัญญา</h2>
  <p>โลโก้ FIXITEC ชื่อทางการค้า ข้อความ และภาพบนเว็บไซต์เป็นทรัพย์สินของ {company.th} ห้ามทำซ้ำหรือดัดแปลงโดยไม่ได้รับอนุญาต</p>

  <h2>ลิงก์ภายนอก</h2>
  <p>เว็บไซต์อาจมีลิงก์ไปยังบริการภายนอก เช่น Google Maps และ LINE ซึ่งอยู่ภายใต้นโยบายของผู้ให้บริการนั้น ๆ</p>

  <h2>ติดต่อ</h2>
  <p>หากมีคำถามเกี่ยวกับข้อตกลงนี้ ติดต่อ {contact.email.display} หรือ {contact.phone.display}</p>
</LegalPage>
