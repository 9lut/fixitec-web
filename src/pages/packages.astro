---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import CompareTable from '../components/CompareTable.astro';
import PromoBand from '../components/PromoBand.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import TapeBand from '../components/TapeBand.astro';
import { pageSeo } from '../config/seo';
import { packages, featureMatrix, addons, packageNote } from '../data/packages';
import { faqGroups } from '../data/faq';
import { faqSchema } from '../lib/schema';

const seo = pageSeo.packages;
const crumbs = [{ name: 'แพ็กเกจ', href: '/packages/' }];
const contractFaqs = faqGroups.find((g) => g.id === 'contract')!.items;
const fmt = new Intl.NumberFormat('th-TH');
---

<Layout title={seo.title} description={seo.description} crumbs={crumbs} schema={[faqSchema(contractFaqs, '/packages/')]}>
  <PageHero crumbs={crumbs} kicker="แพ็กเกจ" title="แพ็กเกจดูแลรายเดือน" lead={packageNote} />

  <TapeBand />

  <!-- package cards -->
  <section class="bg-stripes pt-20 pb-14 lg:pt-28 lg:pb-20">
    <div class="wrap">
    <div class="swipe-row md:grid-cols-3 md:items-start">
      {
        packages.map((p) => (
          <article
            class:list={[
              'cut-corner relative flex h-full flex-col p-7 sm:p-8',
              p.featured ? 'bg-ink text-white shadow-[0_30px_60px_-30px_rgba(17,17,20,0.7)] lg:-mt-4 lg:pb-12' : 'bg-white shadow-[var(--shadow-card)]',
            ]}
            data-reveal
          >
            {p.featured && <span class="skew-tag absolute top-0 right-6 bg-redx px-4 py-1.5 font-display text-xs font-semibold tracking-[0.15em] text-white">แนะนำ</span>}
            <h2 class:list={['font-display text-2xl font-bold', p.featured && 'text-fix-400']}>{p.name}</h2>
            <p class:list={['mt-1 text-[15px]', p.featured ? 'text-white/65' : 'text-muted']}>{p.tagline}</p>
            <p class:list={['mt-6 flex items-center gap-2 border-y py-3 font-display', p.featured ? 'border-white/15' : 'border-line']}>
              <Icon name="mdi:monitor-multiple" class="size-5" />
              {p.devices}
            </p>
            <p class="mt-6 font-display">
              {p.price ? (
                <>
                  <span class="text-3xl font-semibold">฿{fmt.format(p.price)}</span>
                  <span class="opacity-60"> / เดือน</span>
                </>
              ) : (
                <span class="text-2xl font-semibold">ติดต่อสอบถาม</span>
              )}
            </p>
            <ul class="mt-6 flex-1 space-y-2.5 text-[15px]">
              {p.highlights.map((h) => (
                <li class="flex items-start gap-2.5">
                  <Icon name="mdi:check" class:list={['mt-1 size-4 shrink-0', p.featured && 'text-brand']} />
                  {h}
                </li>
              ))}
            </ul>
            <a href={`/contact/?package=${p.id}`} class:list={['btn mt-8', p.featured ? 'btn-primary' : 'btn-outline']}>
              ขอใบเสนอราคา
            </a>
          </article>
        ))
      }
    </div>
    </div>
  </section>

  <!-- feature matrix -->
  <section class="bg-paper py-14 lg:py-20">
    <div class="wrap">
      <SectionHead kicker="เทียบฟีเจอร์" title="แต่ละแพ็กเกจต่างกันอย่างไร" />
      <div class="mt-10 overflow-x-auto bg-white shadow-[var(--shadow-card)]">
        <table class="w-full min-w-[40rem] text-left text-[15px]">
          <thead class="font-display">
            <tr class="border-b border-line">
              <th scope="col" class="sticky left-0 bg-white p-4 font-medium text-muted">ฟีเจอร์</th>
              {packages.map((p) => <th scope="col" class:list={['p-4 font-semibold', p.featured && 'bg-fix-gradient']}>{p.name}</th>)}
            </tr>
          </thead>
          {
            featureMatrix.map((g) => (
              <tbody>
                <tr>
                  <th colspan="4" scope="colgroup" class="bg-paper px-4 py-2.5 font-display text-sm font-medium">{g.group}</th>
                </tr>
                {g.rows.map((r) => (
                  <tr class="border-t border-line">
                    <th scope="row" class="sticky left-0 bg-white p-4 font-normal">{r.label}</th>
                    {r.values.map((v, i) => (
                      <td class:list={['p-4', packages[i].featured && 'bg-fix-50']}>
                        {v === true ? (
                          <Icon name="mdi:check" class="size-5" aria-label="มี" />
                        ) : v === false ? (
                          <span class="text-ink/25" aria-label="ไม่มี">—</span>
                        ) : (
                          v
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
      <p class="mt-3 text-[13px] text-muted sm:hidden">เลื่อนตารางไปทางขวาเพื่อดูทุกแพ็กเกจ</p>
    </div>
  </section>

  <!-- add-ons -->
  <section class="pt-14 pb-20 lg:pt-20 lg:pb-32">
    <div class="wrap">
      <SectionHead kicker="บริการเสริม" title="เพิ่มได้ตามความต้องการ" />
      <ul class="swipe-row mt-8 sm:grid-cols-2 lg:mt-10 xl:grid-cols-4">
        {
          addons.map((a) => (
            <li class="card p-5">
              <Icon name={a.icon} class="size-7" />
              <h3 class="mt-4 font-display text-lg font-semibold">{a.title}</h3>
              <p class="mt-1 text-[15px] text-muted">{a.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- vs in-house -->
  <section class="slant bg-dots-dark bg-ink">
    <div class="wrap max-w-6xl">
      <SectionHead kicker="เปรียบเทียบ" title="คุ้มกว่าจ้าง IT ประจำ" lead="ได้ทีมผู้เชี่ยวชาญหลายด้าน ในค่าใช้จ่ายที่คาดการณ์ได้ทุกเดือน" dark center />
      <div class="mt-14"><CompareTable /></div>
    </div>
  </section>

  <PromoBand />

  <section class="py-14 lg:py-20">
    <div class="wrap grid grid-cols-1 gap-8 xl:grid-cols-[1fr_2fr] [&>*]:min-w-0">
      <SectionHead kicker="FAQ" title="คำถามเรื่องราคา" />
      <FaqList items={contractFaqs} openFirst />
    </div>
  </section>

  <CtaBand />
</Layout>
