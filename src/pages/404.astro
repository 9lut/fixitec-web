---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TapeBand from '../components/TapeBand.astro';
import { pageSeo } from '../config/seo';
import { contact, nav } from '../config/site';
import { services } from '../data/services';

const seo = pageSeo.notFound;
const popular = services.filter((s) => ['computer', 'network-wifi', 'server', 'cctv'].includes(s.slug));
const links = nav.filter((n) => !n.services);
---

<Layout title={seo.title} description={seo.description} noindex>
  <section class="relative overflow-hidden bg-fix-50">
    <div class="bg-stripes absolute inset-y-0 right-0 hidden w-1/2 lg:block" aria-hidden="true"></div>
    <div class="bg-fix-gradient absolute top-0 -right-24 hidden h-full w-[34%] lg:block" style="clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);" aria-hidden="true"></div>

    <div class="wrap relative grid grid-cols-1 items-center gap-10 pt-10 pb-20 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:pt-16 lg:pb-28 [&>*]:min-w-0">
      <div>
        <span class="skew-tag inline-block bg-ink px-4 py-1.5 font-display text-xs font-semibold tracking-[0.16em] text-fix-400 sm:text-sm">ERROR 404</span>

        <!-- 4 ✕ 4 -->
        <p class="mt-6 flex items-center font-display text-[6.5rem] leading-none font-bold sm:text-[9rem]" aria-hidden="true">
          <span>4</span>
          <img src="/images/x-mark.webp" alt="" width="600" height="600" class="mx-1 w-[0.95em] drop-shadow-[0_14px_30px_rgba(227,32,27,0.35)]" />
          <span>4</span>
        </p>

        <h1 class="h-display mt-4">ไม่พบหน้านี้</h1>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-ink-4 sm:text-lg">
          หน้าที่คุณค้นหาอาจถูกย้าย ลบ หรือพิมพ์ที่อยู่ผิด — หน้าเว็บนี้เราซ่อมให้ไม่ได้ แต่ระบบ IT ขององค์กรคุณ เราดูแลได้
        </p>

        <div class="mt-8 grid grid-cols-2 gap-2.5 sm:flex sm:gap-3">
          <a href="/" class="btn btn-dark !px-3 sm:!px-8"><Icon name="mdi:home-outline" class="size-5" />กลับหน้าแรก</a>
          <a href="/contact/" class="btn btn-outline !px-3 sm:!px-7">ติดต่อทีม</a>
        </div>
      </div>

      <!-- "ticket" card -->
      <div class="relative mx-auto w-full max-w-md">
        <div class="cut-corner bg-ink p-6 text-white shadow-[0_40px_80px_-30px_rgba(17,17,20,0.6)] sm:p-7 lg:rotate-2">
          <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-4">
            <div>
              <p class="font-display text-lg font-semibold">เคส #404</p>
              <p class="text-xs text-white/50">IT Care Portal · แจ้งอัตโนมัติ</p>
            </div>
            <span class="flex items-center gap-1.5 bg-redx/15 px-2.5 py-1 text-xs font-medium text-red-300">
              <span class="size-2 rounded-full bg-redx"></span>ไม่พบหน้า
            </span>
          </div>
          <dl class="mt-4 space-y-2.5 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-white/50">อาการ</dt><dd class="text-right">ลิงก์เสีย หรือหน้าถูกย้าย</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-white/50">ผลกระทบ</dt><dd class="text-right">ต่ำ — ระบบอื่นปกติ</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-white/50">วิธีแก้</dt><dd class="text-right text-fix-400">เลือกหน้าที่ต้องการด้านล่าง</dd></div>
          </dl>
          <nav aria-label="หน้าหลักของเว็บไซต์" class="mt-5 border-t border-white/10 pt-4">
            <ul class="grid grid-cols-2 gap-2">
              {
                links.map((l) => (
                  <li>
                    <a href={l.href} class="flex items-center justify-between gap-2 bg-white/5 px-3 py-2.5 text-sm transition hover:bg-fix-400 hover:text-ink">
                      {l.label}
                      <Icon name="mdi:arrow-right" class="size-4 shrink-0" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </section>

  <TapeBand />

  <section class="bg-white pt-20 pb-16 lg:pt-28 lg:pb-24">
    <div class="wrap">
      <SectionHead kicker="บริการยอดนิยม" title="หรือดูบริการของเรา">
        <a href="/services/" class="btn btn-outline hidden sm:inline-flex">บริการทั้งหมด <Icon name="mdi:arrow-right" class="arrow size-5" /></a>
      </SectionHead>
      <div class="swipe-row mt-8 sm:grid-cols-2 lg:mt-10 lg:grid-cols-4">
        {popular.map((s) => <ServiceCard service={s} detailed />)}
      </div>
      <p class="mt-10 flex flex-wrap items-center gap-x-2 gap-y-1 text-[15px] text-muted">
        ต้องการความช่วยเหลือเร่งด่วน?
        <a href={contact.phone.href} class="inline-flex items-center gap-1.5 font-display font-semibold text-ink underline decoration-fix-400 decoration-2 underline-offset-4">
          <Icon name="mdi:phone" class="size-4" />{contact.phone.display}
        </a>
        หรือ
        <a href={contact.line.href} target="_blank" rel="noopener" class="font-display font-semibold text-ink underline decoration-fix-400 decoration-2 underline-offset-4">LINE {contact.line.id}</a>
      </p>
    </div>
  </section>
</Layout>
