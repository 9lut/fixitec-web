---
/**
 * "ลูกค้าที่ไว้วางใจ FIXITEC" — industries, client logo marquee (auto-read from public/images/clients/)
 * and testimonials. Data: src/data/clients.ts
 * Note: no Review JSON-LD on purpose — add it only once the testimonials are real.
 */
import fs from 'node:fs';
import path from 'node:path';
import { Icon } from 'astro-icon/components';
import FxIcon from './FxIcon.astro';
import SectionHead from './ui/SectionHead.astro';
import { clients, logoPreview, testimonials, industries } from '../data/clients';

interface Props {
  class?: string;
}

const { class: className = 'bg-stripes bg-fix-50 py-14 lg:py-24' } = Astro.props;

// logos: every image in public/images/clients/, listed order first, then by file name
const dir = path.join(process.cwd(), 'public', 'images', 'clients');
const files = fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => /\.(svg|webp|png|jpe?g)$/i.test(f)) : [];
const order = (f: string) => {
  const i = clients.findIndex((c) => c.file === f);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};
const logos = files
  .sort((a, b) => order(a) - order(b) || a.localeCompare(b))
  .map((f) => ({ src: `/images/clients/${f}`, name: clients.find((c) => c.file === f)?.name ?? f.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ') }));

const preview = logos.length === 0 && logoPreview.enabled;
const tiles = preview ? Array.from({ length: logoPreview.count }, (_, i) => i) : logos.map((_, i) => i);
const rowA = tiles.filter((_, i) => i % 2 === 0);
const rowB = tiles.filter((_, i) => i % 2 === 1);
const showLogos = tiles.length > 0;
---

<section class={className} aria-labelledby="clients-title">
  <div class="wrap">
    <SectionHead id="clients-title" kicker="ลูกค้าของเรา" title="ลูกค้าที่ไว้วางใจ FIXITEC" lead="ดูแลระบบ IT ให้ธุรกิจหลากหลายประเภท ตั้งแต่สำนักงานขนาดเล็กไปจนถึงองค์กรหลายสาขา" center />

    <!-- industries -->
    <ul class="mt-8 flex flex-wrap justify-center gap-2" data-reveal>
      {
        industries.map((d) => (
          <li class="skew-tag flex items-center gap-2 bg-white px-4 py-2 text-sm font-medium shadow-[var(--shadow-card)]">
            <Icon name={d.icon} class="size-5 text-fix-600" />{d.label}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- logo marquee -->
  {
    showLogos && (
      <div class="mt-10 space-y-3 [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)] lg:mt-14" data-reveal>
        {[rowA, rowB].map((row, r) => (
          <div class="overflow-hidden">
            <ul class:list={['flex w-max gap-3', r === 0 ? 'marquee-track' : 'marquee-track-reverse']}>
              {[...row, ...row, ...row, ...row].map((i) =>
                preview ? (
                  <li class="grid h-20 w-44 shrink-0 place-items-center border-2 border-dashed border-ink/10 bg-white/70 text-ink/30" aria-hidden="true">
                    <span class="flex items-center gap-2 font-display text-sm font-medium">
                      <Icon name="mdi:domain" class="size-6" />โลโก้ลูกค้า
                    </span>
                  </li>
                ) : (
                  <li class="grid h-20 w-44 shrink-0 place-items-center bg-white px-5 shadow-[var(--shadow-card)]">
                    <img src={logos[i].src} alt={logos[i].name} loading="lazy" class="max-h-12 w-auto object-contain opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0" />
                  </li>
                ),
              )}
            </ul>
          </div>
        ))}
      </div>
    )
  }

  <!-- testimonials -->
  {
    testimonials.length > 0 && (
      <div class="wrap mt-12 lg:mt-16">
        <div class="swipe-row md:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="cut-corner relative flex flex-col bg-white p-6 shadow-[var(--shadow-card)] sm:p-7" data-reveal>
              {t.sample && <span class="skew-tag absolute top-0 right-6 bg-fix-100 px-3 py-1 font-display text-xs font-semibold text-fix-800">ตัวอย่าง</span>}
              <span class="font-display text-6xl leading-none text-fix-400" aria-hidden="true">“</span>
              <blockquote class="-mt-3 flex-1 text-[15px] leading-relaxed text-ink-4 sm:text-base">{t.quote}</blockquote>
              <ul class="mt-5 flex gap-1.5" aria-label="บริการที่ใช้">
                {t.services.map((s) => (
                  <li class="grid size-9 place-items-center bg-fix-50"><FxIcon name={s} class="size-6" /></li>
                ))}
              </ul>
              <figcaption class="mt-5 flex items-center gap-3 border-t border-line pt-5">
                <span class="grid size-11 shrink-0 place-items-center bg-ink text-fix-400"><Icon name="mdi:account-tie" class="size-6" /></span>
                <span class="leading-tight">
                  <span class="block font-display font-semibold">{t.author}</span>
                  <span class="block text-sm text-muted">{t.company} · {t.industry}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )
  }
</section>
