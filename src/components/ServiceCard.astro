---
import { Icon } from 'astro-icon/components';
import FxIcon from './FxIcon.astro';
import { serviceHref, serviceNumber, type Service } from '../data/services';

interface Props {
  service: Service;
  /** show the one-line summary under the title */
  detailed?: boolean;
  class?: string;
}

const { service: s, detailed = false, class: className } = Astro.props;
---

<a
  href={serviceHref(s.slug)}
  class:list={['cut-corner group relative flex h-full flex-col bg-white p-5 shadow-[var(--shadow-card)] transition-colors duration-300 hover:bg-ink sm:p-6', className]}
  data-reveal
>
  <span class="absolute top-4 right-5 font-display text-3xl font-bold text-transparent [-webkit-text-stroke:1.2px_#e3940066] transition group-hover:[-webkit-text-stroke:1.2px_#ffd200]">
    {serviceNumber(s)}
  </span>
  <span class="grid size-16 place-items-center bg-fix-50 text-ink transition-colors group-hover:bg-ink-3 group-hover:text-white">
    <FxIcon name={s.icon} class="size-11 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6" />
  </span>
  <h3 class="mt-5 font-display text-lg font-semibold leading-snug transition-colors group-hover:text-white sm:text-xl">{s.title}</h3>
  <p class="mt-0.5 text-sm font-medium text-fix-700 transition-colors group-hover:text-fix-300">{s.short}</p>
  {detailed && <p class="mt-3 text-[15px] leading-relaxed text-ink-4 transition-colors group-hover:text-white/70">{s.summary}</p>}
  <span class="mt-auto inline-flex items-center gap-1.5 pt-5 font-display text-sm font-semibold transition-colors group-hover:text-fix-400">
    รายละเอียด <Icon name="mdi:arrow-right" class="arrow size-4" />
  </span>
</a>
