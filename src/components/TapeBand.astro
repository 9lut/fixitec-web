---
/**
 * Moving "caution tape" bands.
 * double: yellow text tape behind + black tape with service icons in front, crossing at an angle
 * single: one yellow tape (used as a divider above dark sections)
 */
import FxIcon from './FxIcon.astro';
import { services } from '../data/services';
import { tape } from '../data/home';

interface Props {
  variant?: 'double' | 'single';
}

const { variant = 'double' } = Astro.props;
const words = [...tape, ...tape, ...tape];
const items = [...services, ...services];
---

{
  variant === 'double' ? (
    <div class="pointer-events-none relative z-10 -my-8 h-36 overflow-hidden sm:-my-10 sm:h-44" aria-hidden="true">
      <div class="bg-fix-gradient absolute inset-x-[-5%] top-1/2 -translate-y-1/2 rotate-[3deg] py-2 shadow-[0_10px_30px_-10px_rgba(17,17,20,0.35)]">
        <div class="marquee-track-reverse flex w-max items-center">
          {[...words, ...words].map((w) => (
            <span class="flex items-center font-display text-sm font-bold tracking-[0.2em] text-ink">
              <span class="px-5">{w}</span>
              <span class="text-redx">✕</span>
            </span>
          ))}
        </div>
      </div>
      <div class="absolute inset-x-[-5%] top-1/2 -translate-y-1/2 -rotate-[2deg] bg-ink py-3 shadow-[0_18px_40px_-14px_rgba(17,17,20,0.6)]">
        <div class="marquee-track flex w-max items-center">
          {items.map((s) => (
            <span class="flex items-center gap-3 px-6 font-display text-lg font-semibold whitespace-nowrap text-white sm:text-xl">
              <FxIcon name={s.icon} class="size-8 sm:size-9" />
              {s.title}
              <span class="ml-6 size-1.5 rotate-45 bg-fix-400" />
            </span>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <div class="pointer-events-none relative z-20 -mb-6 overflow-hidden py-3" aria-hidden="true">
      <div class="bg-fix-gradient -mx-[5%] -rotate-[1.5deg] py-2 shadow-[0_10px_30px_-10px_rgba(17,17,20,0.45)]">
        <div class="marquee-track flex w-max items-center">
          {[...words, ...words].map((w) => (
            <span class="flex items-center font-display text-sm font-bold tracking-[0.2em] text-ink">
              <span class="px-5">{w}</span>
              <span class="text-redx">✕</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  )
}
