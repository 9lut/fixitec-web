---
/** FIXITEC wordmark. `on="dark"` uses the transparent logo; `on="light"` the white-background one. */
interface Props {
  on?: 'light' | 'dark';
  class?: string;
}

const { on = 'light', class: className = 'h-10 w-auto' } = Astro.props;
const src = on === 'dark' ? '/images/logo-on-dark.webp' : '/images/logo-on-light.webp';
const height = on === 'dark' ? 215 : 216;
---

<img src={src} width="640" height={height} alt="FIXITEC — We Care Beyond Tech" class={className} decoding="async" />
