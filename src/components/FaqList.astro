---
import { Icon } from 'astro-icon/components';

interface Props {
  items: { q: string; a: string }[];
  /** open the first item by default */
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="divide-y divide-ink/10 border-y border-ink/10">
  {
    items.map((item, i) => (
      <details class="group" open={openFirst && i === 0}>
        <summary class="flex cursor-pointer items-start gap-4 py-5 font-display text-[17px] font-medium leading-snug text-ink transition-colors hover:text-fix-800 sm:text-lg">
          <span class="flex-1">{item.q}</span>
          <span class="faq-plus grid size-8 shrink-0 place-items-center bg-fix-100 text-ink transition-transform duration-300">
            <Icon name="mdi:plus" class="size-5" />
          </span>
        </summary>
        <p class="-mt-1 pr-12 pb-6 text-[15px] leading-relaxed text-ink-4 sm:text-base">{item.a}</p>
      </details>
    ))
  }
</div>
